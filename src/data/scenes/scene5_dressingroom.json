  "nodes": [
    {
      "id": "enter_cinnabar",
      "type": "dialogue",
      "speaker": "小月",
      "activeSide": "left",
      "left": "xiaoyue_normal_modern",
      "text": "（朱砂衣的丝面贴上肩膀，凉，又像有体温）……明明是冷的，怎么贴一会儿就热了？",
      "autosave": true,
      "next": "step1_buttons"
    },
    {
      "id": "enter_pink",
      "type": "dialogue",
      "speaker": "小月",
      "activeSide": "left",
      "left": "xiaoyue_normal_modern",
      "text": "（粉色襦裙倒是软软的——可那支朱砂簪一插进发里，头皮就跟着一紧）……簪子怎么这么沉。",
      "autosave": true,
      "next": "step1_buttons"
    },
    {
      "id": "enter_white",
      "type": "dialogue",
      "speaker": "小月",
      "activeSide": "left",
      "left": "xiaoyue_normal_modern",
      "text": "（素白衣穿在身上，反而觉得镜前那块布帘后有一道目光）……我就是来拍个照而已。",
      "autosave": true,
      "next": "step1_buttons_white"
