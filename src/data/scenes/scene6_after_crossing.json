      "type": "dialogue",
      "speaker": "老板娘",
      "activeSide": "right",
      "left": "xiaoyue_possessed_guifei",
      "right": "laobanniang_creepy",
      "text": "（弯下腰，声音绵软）……娘娘，吉时快到了。镇上人，都等您回宫呢。",
      "next": "xiaoyue_inner"
    },
